# Database (Local Development - matches docker-compose.yml)
DATABASE_URL="postgresql://limo_user:limo_password@localhost:5432/limo_booking?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Environment
NODE_ENV="development"

# Keycloak OIDC (Local Development - matches docker-compose.yml)
KEYCLOAK_ISSUER="http://localhost:8080/realms/limo"
KEYCLOAK_CLIENT_ID="nextjs-app"
KEYCLOAK_CLIENT_SECRET="nextjs-app-secret-change-in-production"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-at-least-32-characters-long"

# Tenant (MVP)
DEFAULT_COMPANY_ID="demo-company-texas"
